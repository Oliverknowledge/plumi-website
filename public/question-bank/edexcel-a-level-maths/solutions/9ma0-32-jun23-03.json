{
  "id": "9ma0-32-jun23-03",
  "q": "3",
  "m": 9,
  "parts": [
    {
      "label": "a",
      "ask": "At time \\(t\\) seconds (\\(t \\geq 0\\)) a particle \\(P\\) has velocity \\(\\mathbf{v} = (t^2 - 3t + 7)\\mathbf{i} + (2t^2 - 3)\\mathbf{j}\\) m s⁻¹. Find the speed of \\(P\\) at \\(t = 0\\).",
      "method": "Start with the velocity at t = 0",
      "steps": [
        { "tex": "\\mathbf{v} = (t^2 - 3t + 7)\\mathbf{i} + (2t^2 - 3)\\mathbf{j}", "check": false },
        { "tex": "\\mathbf{v} = (0^2 - 3 \\times 0 + 7)\\mathbf{i} + (2 \\times 0^2 - 3)\\mathbf{j}" },
        { "tex": "= 7\\mathbf{i} - 3\\mathbf{j}", "marks": ["B1"] },
        { "head": "Speed is the magnitude of v" },
        { "tex": "|x\\mathbf{i} + y\\mathbf{j}| = \\sqrt{x^2 + y^2}", "check": false },
        { "tex": "\\text{speed} = \\sqrt{7^2 + (-3)^2}", "marks": ["M1"] },
        { "tex": "= \\sqrt{49 + 9}" },
        { "tex": "= \\sqrt{58}" }
      ],
      "answer": "\\text{speed} = \\sqrt{58} \\approx 7.62\\ \\text{m s}^{-1}",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["B1", "M1", "A1"],
        "answers": [{ "tex": "\\sqrt{58}", "scheme": "sqrt(58)", "derive": "sqrt(7**2 + (-3)**2)" }]
      }
    },
    {
      "label": "b",
      "ask": "Find the value of \\(t\\) when \\(P\\) is moving parallel to \\(\\mathbf{i} + \\mathbf{j}\\).",
      "method": "Parallel to i + j means equal components",
      "steps": [
        { "tex": "t^2 - 3t + 7 = 2t^2 - 3", "why": "\\(\\mathbf{v}\\) is then a multiple of \\(\\mathbf{i} + \\mathbf{j}\\).", "marks": ["M1"] },
        { "tex": "\\Rightarrow 0 = 2t^2 - t^2 + 3t - 3 - 7" },
        { "tex": "\\Rightarrow 0 = t^2 + 3t - 10" },
        { "tex": "\\Rightarrow 0 = (t + 5)(t - 2)" },
        { "text": "\\(t = -5\\) or \\(t = 2\\), but \\(t \\geq 0\\), so reject \\(t = -5\\)." }
      ],
      "answer": "t = 2",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1"],
        "vals": { "t": 2 },
        "answers": [{ "tex": "t = 2", "scheme": "2", "derive": "solveset(Eq(t**2 - 3*t + 7, 2*t**2 - 3), t, Interval(0, oo))" }]
      }
    },
    {
      "label": "c",
      "ask": "Find the acceleration of \\(P\\) at time \\(t\\) seconds.",
      "method": "Differentiate the velocity",
      "steps": [
        { "tex": "\\mathbf{a} = \\frac{\\mathrm{d}\\mathbf{v}}{\\mathrm{d}t}", "check": false },
        { "tex": "\\mathbf{v} = (t^2 - 3t + 7)\\mathbf{i} + (2t^2 - 3)\\mathbf{j}", "why": "Differentiate each component on its own.", "check": false }
      ],
      "answer": "\\mathbf{a} = (2t - 3)\\mathbf{i} + 4t\\mathbf{j}\\ \\text{m s}^{-2}",
      "answerMarks": ["M1", "A1"],
      "check": {
        "marks": ["M1", "A1"],
        "answers": [
          { "tex": "2t - 3", "scheme": "2*t - 3", "derive": "diff(t**2 - 3*t + 7, t)" },
          { "tex": "4t", "scheme": "4*t", "derive": "diff(2*t**2 - 3, t)" }
        ]
      }
    },
    {
      "label": "d",
      "ask": "Find the value of \\(t\\) when the acceleration of \\(P\\) is perpendicular to \\(\\mathbf{i}\\).",
      "method": "Perpendicular to i means no i component",
      "steps": [
        { "tex": "2t - 3 = 0", "why": "Use the \\(\\mathbf{i}\\) component of \\(\\mathbf{a}\\) from part (c).", "marks": ["M1"] },
        { "tex": "\\Rightarrow 2t = 3" },
        { "tex": "\\Rightarrow t = \\frac{3}{2}" }
      ],
      "answer": "t = 1.5",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1"],
        "vals": { "t": "3/2" },
        "answers": [{ "tex": "t = 1.5", "scheme": "3/2", "derive": "solve(diff(t**2 - 3*t + 7, t), t)" }]
      }
    }
  ]
}
