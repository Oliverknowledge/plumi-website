{
  "id": "9ma0-02-jun23-08",
  "q": "8",
  "m": 6,
  "parts": [
    {
      "label": "a",
      "ask": "Express \\(2\\cos\\theta + 8\\sin\\theta\\) in the form \\(R\\cos(\\theta - \\alpha)\\), where \\(R > 0\\) and \\(0 < \\alpha < \\dfrac{\\pi}{2}\\). Give the exact value of \\(R\\) and \\(\\alpha\\) in radians to 3 decimal places.",
      "method": "Expand, then compare coefficients",
      "steps": [
        { "tex": "R\\cos(\\theta - \\alpha) = R\\cos\\theta\\cos\\alpha + R\\sin\\theta\\sin\\alpha", "why": "\\(\\cos(A - B) = \\cos A\\cos B + \\sin A\\sin B\\): a plus sign.", "check": false },
        { "tex": "2\\cos\\theta + 8\\sin\\theta = R\\cos\\theta\\cos\\alpha + R\\sin\\theta\\sin\\alpha", "check": false },
        { "tex": "\\Rightarrow R\\cos\\alpha = 2, \\quad R\\sin\\alpha = 8", "why": "Match the \\(\\cos\\theta\\) terms, then the \\(\\sin\\theta\\) terms." },
        { "head": "Find \\(R\\)" },
        { "tex": "R^2\\cos^2\\alpha + R^2\\sin^2\\alpha = 2^2 + 8^2", "why": "Square and add: \\(\\cos^2\\alpha + \\sin^2\\alpha = 1\\)." },
        { "tex": "\\Rightarrow R^2 = 4 + 64 = 68" },
        { "tex": "\\Rightarrow R = \\sqrt{68} = \\sqrt{4}\\sqrt{17} = 2\\sqrt{17}", "marks": ["B1"] },
        { "head": "Find \\(\\alpha\\)" },
        { "tex": "\\frac{R\\sin\\alpha}{R\\cos\\alpha} = \\tan\\alpha = \\frac{8}{2} = 4" },
        { "tex": "\\Rightarrow \\alpha = \\tan^{-1}(4) = 1.32581\\ldots", "why": "Calculator in radians: the interval is in terms of \\(\\pi\\).", "marks": ["M1"] }
      ],
      "answerText": "\\(2\\cos\\theta + 8\\sin\\theta = 2\\sqrt{17}\\cos(\\theta - 1.326)\\), so \\(R = 2\\sqrt{17}\\) and \\(\\alpha = 1.326\\).",
      "answerMarks": ["A1"],
      "check": {
        "vals": { "R": "2*sqrt(17)", "alpha": "atan(4)" },
        "marks": ["B1", "M1", "A1"],
        "answers": [
          { "text": "\\(R = 2\\sqrt{17}\\)", "value": "2*sqrt(17)", "scheme": "2*sqrt(17)", "derive": "sqrt(2**2 + 8**2)" },
          { "text": "\\(\\alpha = 1.326\\)", "value": "1.326", "scheme": "1.326", "derive": "atan(Rational(8, 2))", "tol": 0.0005 }
        ]
      }
    },
    {
      "label": "b(i)",
      "ask": "The first three terms of an arithmetic sequence are \\(\\cos x\\), \\(\\cos x + \\sin x\\), \\(\\cos x + 2\\sin x\\), with \\(x \\neq n\\pi\\). \\(S_9\\) is the sum of the first 9 terms as \\(x\\) varies. Find the exact maximum value of \\(S_9\\).",
      "method": "First term and common difference",
      "steps": [
        { "tex": "a = \\cos x", "check": false },
        { "tex": "d = (\\cos x + \\sin x) - \\cos x = \\sin x" },
        { "head": "Sum of the first 9 terms" },
        { "tex": "S_n = \\frac{n}{2}\\left(2a + (n - 1)d\\right)", "check": false },
        { "tex": "S_9 = \\frac{9}{2}\\left(2\\cos x + (9 - 1)\\sin x\\right)" },
        { "tex": "= \\frac{9}{2}(2\\cos x + 8\\sin x)" },
        { "head": "Now use part (a)" },
        { "tex": "\\frac{9}{2}(2\\cos x + 8\\sin x) = \\frac{9}{2} \\times 2\\sqrt{17}\\cos(x - \\alpha)", "marks": ["M1"] },
        { "tex": "= 9\\sqrt{17}\\cos(x - \\alpha)" },
        { "text": "The largest value of \\(\\cos(x - \\alpha)\\) is 1." },
        { "tex": "\\Rightarrow 9\\sqrt{17} \\times 1 = 9\\sqrt{17}" }
      ],
      "answer": "\\max S_9 = 9\\sqrt{17}",
      "answerMarks": ["A1"],
      "check": {
        "vals": { "alpha": "atan(4)" },
        "marks": ["M1", "A1"],
        "answers": [{ "tex": "9\\sqrt{17}", "scheme": "9*sqrt(17)", "derive": "Rational(9, 2)*sqrt(2**2 + 8**2)" }]
      }
    },
    {
      "label": "b(ii)",
      "ask": "Deduce the smallest positive value of \\(x\\) at which this maximum value of \\(S_9\\) occurs.",
      "method": "The maximum is where \\(\\cos(x - \\alpha) = 1\\)",
      "steps": [
        { "tex": "\\cos(x - \\alpha) = 1" },
        { "tex": "\\Rightarrow x - \\alpha = 0", "why": "\\(x - \\alpha = -2\\pi\\) makes \\(x\\) negative; \\(+2\\pi\\) makes it larger." },
        { "tex": "\\Rightarrow x = \\alpha = 1.3258\\ldots" }
      ],
      "answer": "x = 1.33",
      "answerMarks": ["B1ft"],
      "check": {
        "vals": { "x": "atan(4)", "alpha": "atan(4)" },
        "marks": ["B1ft"],
        "answers": [{ "tex": "1.33", "scheme": "1.33", "derive": "atan(4)", "tol": 0.005 }]
      }
    }
  ]
}
