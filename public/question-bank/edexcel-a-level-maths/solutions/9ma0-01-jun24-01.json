      "ask": "\\(\\mathrm{g}(x) = 3x^3 - 20x^2 + (k+17)x + k\\). Given that \\((x-3)\\) is a factor of \\(\\mathrm{g}(x)\\), find \\(k\\).",
      "method": "Factor theorem",
      "steps": [
        { "tex": "\\mathrm{g}(3) = 3(3)^3 - 20(3)^2 + (k+17)(3) + k = 0", "why": "\\((x-3)\\) a factor means \\(\\mathrm{g}(3) = 0\\), not \\(\\mathrm{g}(-3)\\).", "marks": ["M1"] },
        { "tex": "\\Rightarrow 81 - 180 + 3k + 51 + k = 0", "why": "Put \\(x = 3\\) in the \\((k+17)x\\) term too." },
        { "tex": "\\Rightarrow 4k = 48", "marks": ["M1"] }
      ],
      "answer": "k = 12",
      "answerMarks": ["A1"],
      "check": {
        "vals": { "k": 12 },
        "marks": ["M1", "M1", "A1"],
        "answers": [{ "tex": "k = 12", "scheme": "12" }]
      }
