{
  "id": "9ma0-01-jun24-03",
  "q": "3",
  "m": 6,
  "parts": [
    {
      "label": "a",
      "ask": "\\(\\mathrm{f}(x) = x + \\tan\\left(\\tfrac{1}{2}x\\right)\\), \\(\\pi < x < \\tfrac{3\\pi}{2}\\). Show that the root \\(\\alpha\\) of \\(\\mathrm{f}(x) = 0\\) lies in \\([3.6, 3.7]\\).",
      "method": "Change of sign",
      "steps": [
        { "tex": "\\mathrm{f}(3.6) = 3.6 + \\tan(1.8) = -0.686\\ldots", "why": "Radians: the domain is in terms of \\(\\pi\\)." },
        { "tex": "\\mathrm{f}(3.7) = 3.7 + \\tan(1.85) = 0.211\\ldots", "marks": ["M1"] },
        { "text": "\\(\\mathrm{f}(3.6) < 0 < \\mathrm{f}(3.7)\\), so the sign changes, and f is continuous on \\([3.6, 3.7]\\).", "why": "Say continuous: without it the graph could jump the axis." }
      ],
      "answerText": "So the root \\(\\alpha\\) lies in \\([3.6, 3.7]\\).",
      "answerMarks": ["A1*"],
      "check": {
        "marks": ["M1", "A1*"],
        "answers": "proof: sign change and continuity"
      }
    },
    {
      "label": "b",
      "ask": "Find \\(\\mathrm{f}'(x)\\).",
      "method": "Differentiate term by term",
      "steps": [
        { "tex": "\\mathrm{f}(x) = x + \\tan\\left(\\tfrac{1}{2}x\\right)", "why": "Formula book: \\(\\tan kx \\to k\\sec^2 kx\\), with \\(k = \\tfrac{1}{2}\\). And \\(x \\to 1\\).", "check": false }
      ],
      "answer": "\\mathrm{f}'(x) = 1 + \\tfrac{1}{2}\\sec^2\\left(\\tfrac{1}{2}x\\right)",
      "answerMarks": ["M1", "A1"],
      "check": {
        "marks": ["M1", "A1"],
        "answers": [{ "tex": "1 + \\tfrac{1}{2}\\sec^2\\left(\\tfrac{1}{2}x\\right)", "scheme": "diff(x + tan(x/2), x)" }]
      }
    },
    {
      "label": "c",
      "ask": "Using 3.7 as a first approximation, apply Newton–Raphson once. Give your answer to 3 decimal places.",
      "method": "Newton–Raphson",
      "steps": [
        { "tex": "x_2 = 3.7 - \\frac{\\mathrm{f}(3.7)}{\\mathrm{f}'(3.7)}", "why": "\\(x_{n+1} = x_n - \\dfrac{\\mathrm{f}(x_n)}{\\mathrm{f}'(x_n)}\\), from the formula book.", "check": false },
        { "tex": "= 3.7 - \\frac{3.7 + \\tan(1.85)}{1 + \\tfrac{1}{2}\\sec^2(1.85)}", "why": "Show this line: a calculator slip with no substitution scores nothing.", "marks": ["M1"] },
        { "tex": "= 3.7 - \\frac{0.21194\\ldots}{7.5833\\ldots}", "why": "No \\(\\sec\\) key: \\(\\sec^2(1.85) = \\dfrac{1}{\\cos^2(1.85)}\\)." },
        { "tex": "= 3.67205\\ldots" }
      ],
      "answer": "\\alpha \\approx 3.672",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1"],
        "answers": [{ "tex": "3.672", "scheme": "3.7 - (3.7 + tan(1.85))/(1 + sec(1.85)**2/2)", "tol": 0.0005 }]
      }
    }
  ]
}
