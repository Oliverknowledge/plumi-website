{
  "id": "9ma0-02-jun23-11",
  "q": "11",
  "m": 10,
  "parts": [
    {
      "label": "a",
      "ask": "A cuboid tank has a base 20 m by 10 m and height 5 m. At time \\(t\\) minutes the water is \\(h\\) m deep and its volume is \\(V\\) m³. In the model, the sides have negligible thickness and the rate of change of \\(V\\) is inversely proportional to \\(\\sqrt{h}\\). Show that \\(\\dfrac{\\mathrm{d}h}{\\mathrm{d}t} = \\dfrac{\\lambda}{\\sqrt{h}}\\), where \\(\\lambda\\) is a constant.",
      "method": "Connected rates of change (the chain rule)",
      "steps": [
        { "tex": "V = 20 \\times 10 \\times h = 200h" },
        { "tex": "\\Rightarrow \\frac{\\mathrm{d}V}{\\mathrm{d}h} = 200", "marks": ["B1"], "check": false },
        { "tex": "\\frac{\\mathrm{d}V}{\\mathrm{d}t} = \\frac{k}{\\sqrt{h}}", "why": "Inversely proportional: a constant \\(k\\) divided by \\(\\sqrt{h}\\).", "check": false },
        { "tex": "\\frac{\\mathrm{d}h}{\\mathrm{d}t} = \\frac{\\mathrm{d}h}{\\mathrm{d}V} \\times \\frac{\\mathrm{d}V}{\\mathrm{d}t}", "why": "\\(\\dfrac{\\mathrm{d}h}{\\mathrm{d}V} = \\dfrac{1}{200}\\), the reciprocal of \\(\\dfrac{\\mathrm{d}V}{\\mathrm{d}h}\\).", "check": false },
        { "tex": "= \\frac{1}{200} \\times \\frac{k}{\\sqrt{h}}", "marks": ["M1"], "check": false },
        { "tex": "= \\frac{k}{200\\sqrt{h}}", "why": "Don't call both constants \\(\\lambda\\): say \\(\\lambda = \\tfrac{k}{200}\\)." }
      ],
      "answer": "\\frac{\\mathrm{d}h}{\\mathrm{d}t} = \\frac{\\lambda}{\\sqrt{h}}, \\quad \\text{where } \\lambda = \\frac{k}{200}",
      "answerMarks": ["A1*"],
      "check": {
        "marks": ["B1", "M1", "A1*"],
        "answers": "show that: chain rule (1/200) x k/sqrt(h), with lambda = k/200",
        "assert": "simplify(Rational(1, 200)*k/sqrt(Symbol('h')) - (k/200)/sqrt(Symbol('h'))) == 0"
      }
    },
    {
      "label": "b",
      "ask": "Initially the water is 1.44 m deep, and exactly 8 minutes later it is 3.24 m deep. Use the model to find an equation \\(h^{\\frac{3}{2}} = At + B\\), where \\(A\\) and \\(B\\) are constants to be found.",
      "method": "Separate the variables, then use the two conditions",
      "steps": [
        { "tex": "\\int h^{\\frac{1}{2}}\\,\\mathrm{d}h = \\int \\lambda\\,\\mathrm{d}t", "why": "Multiply both sides by \\(\\sqrt{h}\\) to separate.", "marks": ["M1"], "check": false },
        { "tex": "\\Rightarrow \\frac{2}{3}h^{\\frac{3}{2}} = \\lambda t + c", "marks": ["A1"] },
        { "tex": "\\frac{2}{3}(1.44)^{\\frac{3}{2}} = \\lambda \\times 0 + c", "why": "Initially means \\(t = 0\\), \\(h = 1.44\\).", "check": { "vals": { "c": "144/125" } } },
        { "tex": "\\Rightarrow c = \\frac{2}{3}(1.728) = 1.152", "why": "\\(1.44^{\\frac{3}{2}} = \\left(\\sqrt{1.44}\\right)^3 = 1.2^3\\).", "marks": ["dM1"] },
        { "tex": "\\frac{2}{3}(3.24)^{\\frac{3}{2}} = 8\\lambda + 1.152", "check": { "vals": { "lambda": "171/500" } } },
        { "tex": "\\Rightarrow 3.888 = 8\\lambda + 1.152 \\;\\Rightarrow\\; \\lambda = \\frac{2.736}{8} = 0.342", "marks": ["ddM1"] },
        { "tex": "\\Rightarrow \\frac{2}{3}h^{\\frac{3}{2}} = 0.342t + 1.152" }
      ],
      "answer": "h^{\\frac{3}{2}} = 0.513t + 1.728",
      "answerMarks": ["A1"],
      "check": {
        "vals": { "lambda": "171/500", "c": "144/125", "t": 8, "h": "81/25" },
        "marks": ["M1", "A1", "dM1", "ddM1", "A1"],
        "answers": [{ "tex": "0.513t + 1.728", "scheme": "0.513*t + 1.728", "derive": "Rational(3, 2)*((Rational(2, 3)*Rational(324, 100)**Rational(3, 2) - Rational(2, 3)*Rational(144, 100)**Rational(3, 2))/8*t + Rational(2, 3)*Rational(144, 100)**Rational(3, 2))" }]
      }
    },
    {
      "label": "c",
      "ask": "Hence find the time taken, from when water started flowing in, for the tank to be completely full.",
      "method": "Full means \\(h = 5\\)",
      "steps": [
        { "tex": "5^{\\frac{3}{2}} = 0.513t + 1.728", "why": "The tank is 5 m high.", "marks": ["M1"], "check": { "vals": { "t": "(5**Rational(3, 2) - Rational(1728, 1000))/Rational(513, 1000)" } } },
        { "tex": "\\Rightarrow t = \\frac{5^{\\frac{3}{2}} - 1.728}{0.513} = \\frac{9.45233\\ldots}{0.513} = 18.4256\\ldots", "check": { "vals": { "t": "(5**Rational(3, 2) - Rational(1728, 1000))/Rational(513, 1000)" } } }
      ],
      "answer": "t = 18.4\\ \\text{minutes}",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1"],
        "answers": [{ "tex": "18.4", "scheme": "18.4", "derive": "(5**Rational(3, 2) - Rational(1728, 1000))/Rational(513, 1000)", "tol": 0.05 }]
      }
    }
  ]
}
