{
  "id": "9ma0-02-jun23-03",
  "q": "3",
  "m": 5,
  "parts": [
    {
      "label": "a",
      "ask": "Given that \\(\\log_2(x+3) + \\log_2(x+10) = 2 + 2\\log_2 x\\), show that \\(3x^2 - 13x - 30 = 0\\).",
      "method": "Use the log laws to make each side a single log",
      "steps": [
        { "tex": "\\log_2(x+3) + \\log_2(x+10) = 2 + 2\\log_2 x" },
        { "tex": "\\Rightarrow \\log_2\\left((x+3)(x+10)\\right) = \\log_2(4) + \\log_2(x^2)", "why": "\\(\\log a + \\log b = \\log ab\\), \\(k\\log a = \\log a^k\\), and \\(2 = \\log_2 4\\).", "marks": ["M1"] },
        { "tex": "= \\log_2(4x^2)" },
        { "tex": "\\Rightarrow (x+3)(x+10) = 4x^2", "why": "Same base both sides, so the insides are equal.", "marks": ["dM1"] },
        { "tex": "\\Rightarrow x^2 + 13x + 30 = 4x^2" }
      ],
      "answer": "\\Rightarrow 3x^2 - 13x - 30 = 0",
      "answerMarks": ["A1*"],
      "check": {
        "vals": { "x": 6 },
        "marks": ["M1", "dM1", "A1*"],
        "answers": [{ "tex": "3x^2 - 13x - 30 = 0", "kind": "identity", "scheme": "3*x**2 - 13*x - 30", "derive": "expand(4*x**2 - (x + 3)*(x + 10))" }]
      }
    },
    {
      "label": "b(i)",
      "ask": "Write down the roots of the equation \\(3x^2 - 13x - 30 = 0\\).",
      "method": "Factorise",
      "steps": [
        { "tex": "3x^2 - 13x - 30 = 0", "check": { "vals": { "x": 6 } } },
        { "tex": "\\Rightarrow (3x + 5)(x - 6) = 0", "why": "Check the middle term: \\(-18x + 5x = -13x\\).", "check": { "vals": { "x": 6 } } }
      ],
      "answer": "\\Rightarrow x = 6 \\ \\text{or}\\ x = -\\frac{5}{3}",
      "answerMarks": ["B1"],
      "check": {
        "marks": ["B1"],
        "answers": [
          { "tex": "x = 6", "scheme": "6", "derive": "Max(*solve(3*x**2 - 13*x - 30, x))" },
          { "tex": "x = -\\frac{5}{3}", "scheme": "-5/3", "derive": "Min(*solve(3*x**2 - 13*x - 30, x))" }
        ]
      }
    },
    {
      "label": "b(ii)",
      "ask": "Hence state which of the roots in part (b)(i) is not a solution of \\(\\log_2(x+3) + \\log_2(x+10) = 2 + 2\\log_2 x\\), giving a reason.",
      "method": "Put each root back into the logs",
      "steps": [
        { "text": "At \\(x = -\\tfrac{5}{3}\\), the term \\(\\log_2 x\\) becomes \\(\\log_2\\left(-\\tfrac{5}{3}\\right)\\).", "why": "Not \"logs can't be negative\": the inside must be positive." }
      ],
      "answerText": "\\(x = -\\tfrac{5}{3}\\) is not a solution, because \\(\\log_2\\left(-\\tfrac{5}{3}\\right)\\) is the log of a negative number, which is not real.",
      "answerMarks": ["B1"],
      "check": {
        "marks": ["B1"],
        "answers": [{ "text": "\\(x = -\\tfrac{5}{3}\\)", "value": "-5/3", "scheme": "-5/3" }]
      }
    }
  ]
}
