{
  "id": "9ma0-31-jun23-05",
  "q": "5",
  "m": 8,
  "parts": [
    {
      "label": "a",
      "ask": "A spinner gives \\(X = 20, 50, 80, 100\\) with probabilities \\(a, b, c, d\\). Tisam stands \\(x\\) cm from a cup and throws a ball; \\(S\\) is the event she gets it in. Her model: \\(\\mathrm{P}(S \\mid \\{X = x\\}) = \\dfrac{k}{x}\\) for a constant \\(k\\), and \\(\\mathrm{P}(S \\cap \\{X = x\\})\\) is the same for every \\(x\\). Show that \\(c = \\tfrac{8}{5}b\\).",
      "method": "Start from the conditional probability rule",
      "steps": [
        { "tex": "\\mathrm{P}(S \\cap \\{X = x\\}) = \\mathrm{P}(S \\mid \\{X = x\\}) \\times \\mathrm{P}(X = x)", "check": false },
        { "head": "Apply it at x = 50 and at x = 80" },
        { "tex": "\\mathrm{P}(S \\cap \\{X = 50\\}) = \\frac{k}{50} \\times b", "check": false },
        { "tex": "\\mathrm{P}(S \\cap \\{X = 80\\}) = \\frac{k}{80} \\times c", "check": false },
        { "head": "The model says these are equal" },
        { "tex": "\\frac{k}{50} \\times b = \\frac{k}{80} \\times c", "marks": ["M1"] },
        { "tex": "\\Rightarrow \\frac{b}{50} = \\frac{c}{80}", "why": "Divide both sides by \\(k\\)." },
        { "tex": "\\Rightarrow c = \\frac{80}{50}b", "why": "Multiply both sides by 80." }
      ],
      "answer": "c = \\frac{8}{5}b",
      "answerMarks": ["A1cso*"],
      "check": {
        "marks": ["M1", "A1cso*"],
        "vals": { "b": "1/5", "c": "8/25", "k": "10" },
        "answers": [{ "tex": "\\frac{8}{5}b", "kind": "identity", "scheme": "8*b/5", "derive": "solve(Eq(k*b/50, k*c/80), c)" }]
      }
    },
    {
      "label": "b",
      "ask": "Find the probability distribution of \\(X\\).",
      "method": "Link a and d to b in the same way",
      "steps": [
        { "tex": "\\frac{k}{20} \\times a = \\frac{k}{50} \\times b", "why": "Same idea as (a), for \\(x = 20\\) and \\(x = 50\\)." },
        { "tex": "\\Rightarrow a = \\frac{20}{50}b = \\frac{2}{5}b", "marks": ["M1"] },
        { "tex": "\\frac{k}{100} \\times d = \\frac{k}{50} \\times b" },
        { "tex": "\\Rightarrow d = \\frac{100}{50}b = 2b", "marks": ["A1"] },
        { "head": "The probabilities add up to 1" },
        { "tex": "a + b + c + d = 1" },
        { "tex": "\\Rightarrow \\frac{2}{5}b + b + \\frac{8}{5}b + 2b = 1", "why": "Write everything in terms of \\(b\\).", "marks": ["M1"] },
        { "tex": "\\Rightarrow \\frac{2}{5}b + \\frac{5}{5}b + \\frac{8}{5}b + \\frac{10}{5}b = 1" },
        { "tex": "\\Rightarrow \\frac{25}{5}b = 1" },
        { "tex": "\\Rightarrow 5b = 1" },
        { "tex": "\\Rightarrow b = \\frac{1}{5}", "marks": ["A1"] },
        { "head": "Finally, a, c and d" },
        { "tex": "a = \\frac{2}{5} \\times \\frac{1}{5} = \\frac{2}{25}" },
        { "tex": "c = \\frac{8}{5} \\times \\frac{1}{5} = \\frac{8}{25}" },
        { "tex": "d = 2 \\times \\frac{1}{5} = \\frac{2}{5}" }
      ],
      "answer": "\\begin{array}{c|cccc} x & 20 & 50 & 80 & 100 \\\\ \\hline \\mathrm{P}(X = x) & \\frac{2}{25} & \\frac{1}{5} & \\frac{8}{25} & \\frac{2}{5} \\end{array}",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1", "M1", "A1", "A1"],
        "vals": { "a": "2/25", "b": "1/5", "c": "8/25", "d": "2/5", "k": "10" },
        "answers": [
          { "tex": "\\frac{2}{25}", "scheme": "2/25", "derive": "Rational(20, 20 + 50 + 80 + 100)" },
          { "tex": "\\frac{1}{5}", "scheme": "1/5", "derive": "Rational(50, 20 + 50 + 80 + 100)" },
          { "tex": "\\frac{8}{25}", "scheme": "8/25", "derive": "Rational(80, 20 + 50 + 80 + 100)" },
          { "tex": "\\frac{2}{5}", "scheme": "2/5", "derive": "Rational(100, 20 + 50 + 80 + 100)" }
        ]
      }
    },
    {
      "label": "c",
      "ask": "Nav throws from 100 cm a large number of times and gets the ball in the cup 30% of the time. State, giving a reason, why Tisam's model is not suitable to describe Nav playing the game for all values of \\(X\\).",
      "method": "Find Nav's value of k",
      "steps": [
        { "tex": "\\mathrm{P}(S \\mid \\{X = 100\\}) = \\frac{k}{100}", "check": false },
        { "tex": "\\frac{k}{100} = 0.3", "why": "His success rate at 100 cm is 30%." },
        { "tex": "\\Rightarrow k = 0.3 \\times 100 = 30" },
        { "head": "Now test the model at x = 20" },
        { "tex": "\\mathrm{P}(S \\mid \\{X = 20\\}) = \\frac{k}{20} = \\frac{30}{20} = 1.5" }
      ],
      "answerText": "With \\(k = 30\\), the model gives a probability of \\(1.5\\) at \\(x = 20\\). A probability cannot be greater than 1, so the model does not work for Nav.",
      "answerMarks": ["B1"],
      "check": {
        "marks": ["B1"],
        "vals": { "k": "30" },
        "answers": [{ "text": "1.5", "value": "1.5", "scheme": "Rational(30, 20)", "derive": "Rational(3, 10)*100/20" }]
      }
    }
  ]
}
