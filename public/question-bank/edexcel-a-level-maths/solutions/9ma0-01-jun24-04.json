      "ask": "Given that \\(y = x^2\\), use differentiation from first principles to show that \\(\\dfrac{\\mathrm{d}y}{\\mathrm{d}x} = 2x\\).",
      "method": "Differentiate from first principles",
      "steps": [
        { "tex": "\\frac{(x+h)^2 - x^2}{h} = \\frac{x^2 + 2xh + h^2 - x^2}{h}", "why": "Gradient of the chord from \\(x\\) to \\(x + h\\).", "marks": ["M1"] },
        { "tex": "= \\frac{2xh + h^2}{h}", "marks": ["A1"] },
        { "tex": "= 2x + h", "why": "Cancelling \\(h\\) is fine: \\(h \\neq 0\\) for a chord." }
      ],
      "answer": "\\frac{\\mathrm{d}y}{\\mathrm{d}x} = \\lim_{h \\to 0}(2x + h) = 2x",
      "answerMarks": ["A1*"],
      "check": {
        "marks": ["M1", "A1", "A1*"],
        "answers": [{ "tex": "2x", "scheme": "diff(x**2, x)" }]
      }
    }
  ]
}
