{
  "id": "9ma0-01-jun23-07",
  "q": "7",
  "m": 8,
  "parts": [
    {
      "label": "a",
      "ask": "\\(\\mathrm{f}(x) = 3 + \\sqrt{x - 2}\\), \\(x \\in \\mathbb{R}\\), \\(x > 2\\). State the range of f.",
      "method": "Smallest value of the square root",
      "steps": [
        { "text": "For \\(x > 2\\), \\(\\sqrt{x - 2} > 0\\), so \\(3 + \\sqrt{x - 2} > 3\\).", "why": "Strict: \\(x = 2\\) is not in the domain." }
      ],
      "answer": "\\mathrm{f}(x) > 3",
      "answerMarks": ["B1"],
      "check": {
        "marks": ["B1"],
        "answers": [{ "tex": "\\mathrm{f}(x) > 3", "kind": "set", "var": "\\mathrm{f}(x)", "scheme": "Interval.open(3, oo)" }]
      }
    },
    {
      "label": "b",
      "ask": "Find \\(\\mathrm{f}^{-1}\\).",
      "method": "Make \\(x\\) the subject",
      "steps": [
        { "tex": "y = 3 + \\sqrt{x - 2}" },
        { "tex": "\\Rightarrow y - 3 = \\sqrt{x - 2}", "why": "Undo in reverse order: subtract 3, then square." },
        { "tex": "\\Rightarrow (y - 3)^2 = x - 2" },
        { "tex": "\\Rightarrow x = (y - 3)^2 + 2", "marks": ["M1"] }
      ],
      "answer": "\\mathrm{f}^{-1}(x) = (x - 3)^2 + 2, \\quad x > 3",
      "answerMarks": ["A1", "B1ft"],
      "check": {
        "marks": ["M1", "A1", "B1ft"],
        "vals": { "x": 6, "y": 5 },
        "answers": [
          { "tex": "(x - 3)^2 + 2", "scheme": "(x - 3)**2 + 2", "derive": "solve(Eq(y, 3 + sqrt(x - 2)), x)[0].subs(y, x)" },
          { "tex": "x > 3", "kind": "set", "scheme": "Interval.open(3, oo)" }
        ]
      }
    },
    {
      "label": "c",
      "ask": "\\(\\mathrm{g}(x) = \\dfrac{15}{x - 3}\\), \\(x \\in \\mathbb{R}\\), \\(x \\neq 3\\). Find \\(\\mathrm{gf}(6)\\).",
      "method": "Apply f first, then g",
      "steps": [
        { "tex": "\\mathrm{f}(6) = 3 + \\sqrt{6 - 2} = 5", "why": "\\(\\mathrm{gf}\\) means do f first." },
        { "tex": "\\mathrm{g}(5) = \\frac{15}{5 - 3}", "marks": ["M1"] }
      ],
      "answer": "= \\frac{15}{2}",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1"],
        "answers": [{ "tex": "\\frac{15}{2}", "scheme": "Rational(15, 2)", "derive": "15/((3 + sqrt(6 - 2)) - 3)" }]
      }
    },
    {
      "label": "d",
      "ask": "Find the exact value of the constant \\(a\\) for which \\(\\mathrm{f}(a^2 + 2) = \\mathrm{g}(a)\\).",
      "method": "Form an equation in \\(a\\)",
      "steps": [
        { "tex": "3 + \\sqrt{a^2 + 2 - 2} = \\frac{15}{a - 3}" },
        { "tex": "\\Rightarrow 3 + a = \\frac{15}{a - 3}", "why": "\\(\\sqrt{a^2} = |a|\\). The left side is over 3, so \\(\\dfrac{15}{a - 3} > 0\\): \\(a > 3\\) and \\(|a| = a\\)." },
        { "tex": "\\Rightarrow (a + 3)(a - 3) = 15" },
        { "tex": "\\Rightarrow a^2 - 9 = 15", "marks": ["M1"] },
        { "tex": "\\Rightarrow a^2 = 24", "why": "Take the positive root: \\(a > 3\\)." }
      ],
      "answer": "\\Rightarrow a = \\sqrt{24} = 2\\sqrt{6}",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1"],
        "vals": { "a": "2*sqrt(6)" },
        "answers": [{ "tex": "2\\sqrt{6}", "scheme": "2*sqrt(6)", "derive": "solveset(Eq(3 + sqrt(a**2), 15/(a - 3)), a, S.Reals)" }]
      }
    }
  ]
}
