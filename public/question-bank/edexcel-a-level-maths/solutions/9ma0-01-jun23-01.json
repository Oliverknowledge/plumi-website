      "label": "",
      "ask": "Find \\(\\displaystyle\\int \\frac{x^{\\frac{1}{2}}(2x - 5)}{3}\\,\\mathrm{d}x\\), writing each term in simplest form.",
      "method": "Start by writing it as powers of x",
      "steps": [
        { "tex": "\\frac{x^{\\frac{1}{2}}(2x - 5)}{3} = \\frac{1}{3}\\left(2x \\times x^{\\frac{1}{2}} - 5x^{\\frac{1}{2}}\\right)" },
        { "tex": "= \\frac{1}{3}\\left(2x^{\\frac{3}{2}} - 5x^{\\frac{1}{2}}\\right)", "why": "\\(x \\times x^{\\frac{1}{2}} = x^{1 + \\frac{1}{2}} = x^{\\frac{3}{2}}\\).", "marks": ["M1"] },
        { "tex": "= \\frac{2}{3}x^{\\frac{3}{2}} - \\frac{5}{3}x^{\\frac{1}{2}}", "marks": ["A1"] },
        { "head": "Now integrate term by term" },
        { "tex": "\\int \\left(\\frac{2}{3}x^{\\frac{3}{2}} - \\frac{5}{3}x^{\\frac{1}{2}}\\right)\\mathrm{d}x = \\frac{2}{3} \\times \\frac{x^{\\frac{5}{2}}}{\\frac{5}{2}} - \\frac{5}{3} \\times \\frac{x^{\\frac{3}{2}}}{\\frac{3}{2}} + c", "why": "Add one to each power, then divide by the new power.", "marks": ["dM1"] },
        { "tex": "= \\frac{2}{3} \\times \\frac{2}{5}x^{\\frac{5}{2}} - \\frac{5}{3} \\times \\frac{2}{3}x^{\\frac{3}{2}} + c", "why": "Dividing by \\(\\tfrac{5}{2}\\) is multiplying by \\(\\tfrac{2}{5}\\)." }
      ],
      "answer": "= \\frac{4}{15}x^{\\frac{5}{2}} - \\frac{10}{9}x^{\\frac{3}{2}} + c",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1", "dM1", "A1"],
        "answers": [{ "tex": "\\frac{4}{15}x^{\\frac{5}{2}} - \\frac{10}{9}x^{\\frac{3}{2}} + c", "scheme": "Rational(4, 15)*x**Rational(5, 2) - Rational(10, 9)*x**Rational(3, 2) + c", "derive": "integrate(sqrt(x)*(2*x - 5)/3, x) + c" }]
      }
    }
  ]
}
