{
  "id": "9ma0-01-jun23-09",
  "q": "9",
  "m": 7,
  "parts": [
    {
      "label": "a",
      "ask": "The first three terms of a geometric sequence are \\(3k + 4\\), \\(12 - 3k\\) and \\(k + 16\\), where \\(k\\) is a constant. Show that \\(3k^2 - 62k + 40 = 0\\).",
      "method": "Equal common ratios",
      "steps": [
        { "tex": "\\frac{12 - 3k}{3k + 4} = \\frac{k + 16}{12 - 3k}", "why": "Each term divided by the one before gives the same \\(r\\).", "marks": ["M1"] },
        { "tex": "\\Rightarrow (12 - 3k)^2 = (3k + 4)(k + 16)" },
        { "tex": "\\Rightarrow 144 - 72k + 9k^2 = 3k^2 + 52k + 64", "why": "Expand both sides fully before collecting terms." },
        { "tex": "\\Rightarrow 6k^2 - 124k + 80 = 0" }
      ],
      "answer": "\\Rightarrow 3k^2 - 62k + 40 = 0",
      "answerMarks": ["A1*"],
      "check": {
        "marks": ["M1", "A1*"],
        "vals": { "k": 20 },
        "answers": [{ "tex": "3k^2 - 62k + 40 = 0", "kind": "equation", "scheme": "Eq(3*k**2 - 62*k + 40, 0)", "derive": "Eq((12 - 3*k)**2 - (3*k + 4)*(k + 16), 0)" }]
      }
    },
    {
      "label": "b(i)",
      "ask": "The sequence converges. Find the value of \\(k\\), giving a reason for your answer.",
      "method": "Solve, then test \\(|r| < 1\\)",
      "steps": [
        { "tex": "3k^2 - 62k + 40 = (3k - 2)(k - 20) = 0" },
        { "tex": "\\Rightarrow k = \\frac{2}{3} \\ \\text{or}\\ k = 20", "marks": ["M1"], "check": false },
        { "tex": "k = 20: \\quad r = \\frac{12 - 3(20)}{3(20) + 4} = \\frac{-48}{64} = -\\frac{3}{4}", "why": "A geometric sequence converges only when \\(|r| < 1\\)." },
        { "tex": "k = \\frac{2}{3}: \\quad r = \\frac{12 - 3\\left(\\frac{2}{3}\\right)}{3\\left(\\frac{2}{3}\\right) + 4} = \\frac{10}{6} = \\frac{5}{3}", "check": { "vals": { "k": "2/3" } } }
      ],
      "answerText": "\\(k = 20\\), because it gives \\(|r| = \\tfrac{3}{4} < 1\\), so the sequence converges. (\\(k = \\tfrac{2}{3}\\) gives \\(r = \\tfrac{5}{3} > 1\\), which diverges.)",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1"],
        "vals": { "k": 20 },
        "answers": [{ "text": "\\(k = 20\\)", "value": "20", "scheme": "20", "derive": "Max(*solve(3*k**2 - 62*k + 40, k))" }]
      }
    },
    {
      "label": "b(ii)",
      "ask": "Find the value of \\(S_\\infty\\).",
      "method": "Sum to infinity",
      "steps": [
        { "tex": "a = 3(20) + 4 = 64, \\quad r = -\\frac{3}{4}", "marks": ["B1"] },
        { "tex": "S_\\infty = \\frac{a}{1 - r} = \\frac{64}{1 - \\left(-\\frac{3}{4}\\right)}", "why": "Formula book: \\(S_\\infty = \\dfrac{a}{1 - r}\\). Mind the double minus.", "marks": ["M1"] },
        { "tex": "= \\frac{64}{\\frac{7}{4}}" }
      ],
      "answer": "= \\frac{256}{7}",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["B1", "M1", "A1"],
        "vals": { "a": 64, "r": "-3/4" },
        "answers": [{ "tex": "\\frac{256}{7}", "scheme": "Rational(256, 7)", "derive": "(3*20 + 4)/(1 - Rational(12 - 3*20, 3*20 + 4))" }]
      }
    }
  ]
}
