  "parts": [
    {
      "label": "",
      "ask": "\\(ABCOA\\) is a semicircle, centre \\(O\\), diameter 10 cm. \\(OB\\) is an arc of a circle with centre \\(A\\) and radius 5 cm. Find the exact area of the shaded region \\(R\\), bounded by arc \\(OB\\), arc \\(BC\\) and line \\(OC\\), in the form \\((a\\sqrt{3} + b\\pi)\\) cm².",
      "method": "Start with the angles",
      "steps": [
        { "text": "\\(AO = OB = 5\\) (radii of the semicircle) and \\(AB = 5\\) (radius of the arc \\(OB\\)), so triangle \\(AOB\\) is equilateral.", "why": "Every length is 5 cm: that's the key to the question." },
        { "tex": "\\angle OAB = \\angle AOB = \\frac{\\pi}{3}", "check": false },
        { "tex": "\\angle BOC = \\pi - \\frac{\\pi}{3} = \\frac{2\\pi}{3}", "why": "Angles on a straight line \\(AOC\\).", "marks": ["B1"], "check": false },
        { "text": "\\(R\\) is sector \\(BOC\\) minus the segment between the chord \\(OB\\) and the arc \\(OB\\)." },
        { "head": "Area of the segment on chord \\(OB\\)" },
        { "tex": "\\text{Sector } AOB = \\tfrac{1}{2}r^2\\theta = \\tfrac{1}{2}(5^2)\\left(\\frac{\\pi}{3}\\right) = \\frac{25\\pi}{6}", "why": "This sector is centred at \\(A\\), angle \\(\\tfrac{\\pi}{3}\\)." },
        { "tex": "\\text{Triangle } AOB = \\tfrac{1}{2}ab\\sin C = \\tfrac{1}{2}(5)(5)\\sin\\frac{\\pi}{3} = \\frac{25}{2} \\times \\frac{\\sqrt{3}}{2} = \\frac{25\\sqrt{3}}{4}" },
        { "tex": "\\text{Segment} = \\tfrac{1}{2}(5^2)\\left(\\frac{\\pi}{3}\\right) - \\tfrac{1}{2}(5^2)\\sin\\frac{\\pi}{3}", "marks": ["M1"] },
        { "tex": "= \\frac{25\\pi}{6} - \\frac{25\\sqrt{3}}{4}" },
        { "head": "Area of sector \\(BOC\\)" },
        { "tex": "\\text{Sector } BOC = \\tfrac{1}{2}(5^2)\\left(\\frac{2\\pi}{3}\\right) = \\frac{25\\pi}{3}" },
        { "head": "Finally, sector minus segment" },
        { "tex": "R = \\frac{25\\pi}{3} - \\left(\\frac{25\\pi}{6} - \\frac{25\\sqrt{3}}{4}\\right)", "why": "Keep the bracket: subtracting the segment adds the triangle back.", "marks": ["dM1"] },
        { "tex": "= \\frac{25\\pi}{3} - \\frac{25\\pi}{6} + \\frac{25\\sqrt{3}}{4}" },
        { "tex": "= \\frac{50\\pi}{6} - \\frac{25\\pi}{6} + \\frac{25\\sqrt{3}}{4}" }
      ],
      "answer": "R = \\left(\\frac{25}{4}\\sqrt{3} + \\frac{25}{6}\\pi\\right)\\ \\text{cm}^2",
      "answerMarks": ["A1"],
      "check": {
        "vals": { "R": "25*sqrt(3)/4 + 25*pi/6" },
        "marks": ["B1", "M1", "dM1", "A1"],
        "answers": [{ "tex": "\\frac{25}{4}\\sqrt{3} + \\frac{25}{6}\\pi", "scheme": "25*sqrt(3)/4 + 25*pi/6", "derive": "Rational(1, 2)*25*(2*pi/3) - (Rational(1, 2)*25*(pi/3) - Rational(1, 2)*25*sin(pi/3))" }]
      }
    }
  ]
}
