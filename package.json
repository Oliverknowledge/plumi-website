{
  "name": "plumi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy:pending": "git fetch -q origin main production && git log --oneline origin/production..origin/main",
    "deploy": "git fetch -q origin main production && git log --oneline origin/production..origin/main && git push origin origin/main:production",
    "lint": "eslint src",
    "pretypecheck": "npm run -s bank:registry",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/question-bank/bank-registry.mjs",
    "calculator:test": "node scripts/calculator/check-runtime.mjs && node scripts/calculator/check-firmware.mjs",
    "og": "tsx scripts/build-og-image.ts",
    "og:lofi": "tsx scripts/build-og-lofi.ts",
    "study:tokens": "tsx scripts/study-tokens.ts",
    "study:contrast": "tsx scripts/study-contrast.ts",
    "social:test": "tsx --test src/lib/social/social.test.ts",
    "preapp:test": "npm run -s bank:registry",
    "app:test": "tsx --test src/lib/studyapp/*.test.ts src/lib/studyapp/questions/*.test.ts src/lib/studyapp/marking/*.test.ts src/lib/studyapp/sharing/*.test.ts src/lib/pro/*.test.ts src/lib/sessionStorage.test.ts src/lib/safePath.test.ts src/lib/account.apple.test.ts src/lib/accountName.test.ts src/content/legal.apple.test.ts src/content/legal.appleOff.test.ts src/lib/authErrors.test.ts",
    "sharing:test": "tsx --test src/lib/studyapp/sharing/*.test.ts",
    "sharing:contract": "tsx scripts/shared-decks-contract.ts",
    "dark:test": "tsx --test src/lib/darkQuestions.test.ts",
    "saved:test": "tsx --experimental-test-module-mocks --test src/lib/bankSaved.test.ts src/lib/bankSync.test.ts",
    "prepdf:test": "npm run -s bank:registry",
    "pdf:test": "tsx --test src/lib/questionSetPdf.test.ts",
    "markpacks:test": "tsx --test scripts/question-bank/markpacks/*.test.ts",
    "dark:score": "tsx scripts/dark-questions/score.ts",
    "social:vectors": "tsx scripts/social-vectors.ts",
    "social:check-sql": "tsx scripts/social-check-sql.ts",
    "social:contract": "tsx scripts/social-contract.ts",
    "social:e2e": "tsx scripts/social-e2e.ts",
    "social:fuzz-library": "tsx scripts/social-fuzz-library.ts",
    "library:seats": "tsx scripts/library-seats.ts",
    "library:test": "tsx --test src/lib/studyapp/library/*.test.ts src/lib/studyapp/library/people/*.test.ts src/lib/social/library.test.ts",
    "social:verify": "npm run -s social:test && npm run -s social:check-sql -- --check && npm run -s social:vectors -- --check",
    "seo:map": "tsx scripts/build-keyword-map.ts",
    "papers:fetch": "for b in aqa edexcel ocr wjec cie; do python3 scripts/past-papers/boards/$b.py || exit 1; done",
    "papers:build": "python3 scripts/past-papers/build.py",
    "papers:upload": "python3 scripts/past-papers/upload.py",
    "bank:fetch": "python3 scripts/question-bank/fetch_aqa.py",
    "bank:spec": "python3 scripts/question-bank/spec.py",
    "bank:cut": "python3 scripts/question-bank/cut.py",
    "bank:build": "python3 scripts/question-bank/build_bank.py",
    "bank:upload": "python3 scripts/question-bank/upload_r2.py",
    "bank:data": "python3 scripts/question-bank/upload_data.py",
    "bank:registry": "node scripts/question-bank/bank-registry.mjs",
    "bank:status": "python3 scripts/question-bank/status.py",
    "bank:check": "python3 scripts/question-bank/check_bank.py",
    "bank:insights": "tsx scripts/question-bank/build-insights.ts",
    "decks:build": "tsx scripts/premade-decks/build.ts",
    "decks:leak-check": "tsx scripts/premade-decks/leak-check.ts",
    "bank:fetch:edexcel": "python3 scripts/question-bank/fetch_edexcel.py",
    "bank:cut:edexcel": "python3 scripts/question-bank/cut_edexcel.py",
    "bank:build:edexcel": "python3 scripts/question-bank/build_bank_edexcel.py",
    "bank:fetch:gcse": "python3 scripts/question-bank/aqa_gcse/fetch_gcse.py",
    "bank:spec:gcse": "python3 scripts/question-bank/aqa_gcse/spec_gcse.py",
    "bank:cut:gcse": "python3 scripts/question-bank/aqa_gcse/cut_gcse.py scripts/question-bank/.work-gcse",
    "bank:build:gcse": "python3 scripts/question-bank/aqa_gcse/build_gcse.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "katex": "0.16.22",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "perfect-freehand": "^1.2.3",
    "posthog-js": "^1.429.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
