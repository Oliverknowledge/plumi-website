{
  "id": "9ma0-02-jun23-09",
  "q": "9",
  "m": 7,
  "parts": [
    {
      "label": "a",
      "ask": "The curve \\(C\\) has parametric equations \\(x = t^2 + 6t - 16\\), \\(y = 6\\ln(t+3)\\), \\(t > -3\\). Show that a Cartesian equation for \\(C\\) is \\(y = A\\ln(x + B)\\), \\(x > -B\\), where \\(A\\) and \\(B\\) are integers to be found.",
      "method": "Complete the square in \\(x\\)",
      "steps": [
        { "tex": "x = t^2 + 6t - 16" },
        { "tex": "= (t + 3)^2 - 9 - 16", "why": "\\((t+3)^2 = t^2 + 6t + 9\\), so take the 9 off again." },
        { "tex": "= (t + 3)^2 - 25", "marks": ["M1"] },
        { "head": "Make \\(t + 3\\) the subject" },
        { "tex": "\\Rightarrow (t + 3)^2 = x + 25" },
        { "tex": "\\Rightarrow t + 3 = (x + 25)^{\\frac{1}{2}}", "why": "Positive root only: \\(t > -3\\) makes \\(t + 3 > 0\\)." },
        { "head": "Substitute into \\(y\\)" },
        { "tex": "y = 6\\ln(t + 3)" },
        { "tex": "\\Rightarrow y = 6\\ln\\left((x + 25)^{\\frac{1}{2}}\\right)", "marks": ["M1"] },
        { "tex": "= 6 \\times \\frac{1}{2}\\ln(x + 25)", "why": "\\(\\ln a^k = k\\ln a\\)." }
      ],
      "answer": "\\Rightarrow y = 3\\ln(x + 25), \\quad x > -25, \\quad A = 3,\\ B = 25",
      "answerMarks": ["A1cso"],
      "check": {
        "vals": { "t": 2, "x": 0, "y": "6*log(5)", "A": 3, "B": 25 },
        "marks": ["M1", "M1", "A1cso"],
        "answers": [{ "tex": "3\\ln(x + 25)", "scheme": "3*log(x + 25)", "derive": "6*log(sqrt(x + 25))" }]
      }
    },
    {
      "label": "b",
      "ask": "\\(C\\) cuts the \\(y\\)-axis at \\(P\\). Show that the tangent to \\(C\\) at \\(P\\) can be written as \\(ax + by = c\\ln 5\\), where \\(a\\), \\(b\\) and \\(c\\) are integers to be found.",
      "method": "Find \\(P\\): on the \\(y\\)-axis \\(x = 0\\)",
      "steps": [
        { "tex": "y = 3\\ln(0 + 25) = 3\\ln 25", "check": { "vals": { "x": 0, "y": "6*log(5)" } } },
        { "tex": "= 3\\ln(5^2) = 3 \\times 2\\ln 5 = 6\\ln 5", "why": "\\(\\ln 25 = \\ln 5^2 = 2\\ln 5\\).", "marks": ["B1ft"], "check": { "vals": { "x": 0, "y": "6*log(5)" } } },
        { "text": "So \\(P\\) is \\((0,\\ 6\\ln 5)\\)." },
        { "head": "Gradient of \\(C\\) at \\(P\\)" },
        { "tex": "\\frac{\\mathrm{d}y}{\\mathrm{d}x} = 3 \\times \\frac{1}{x + 25} = \\frac{3}{x + 25}", "why": "\\(\\ln(x + 25) \\to \\dfrac{1}{x + 25}\\)." },
        { "tex": "x = 0: \\quad \\frac{\\mathrm{d}y}{\\mathrm{d}x} = \\frac{3}{0 + 25} = \\frac{3}{25}", "marks": ["M1"], "check": { "vals": { "x": 0 } } },
        { "head": "Equation of the tangent" },
        { "tex": "y - y_1 = m(x - x_1)", "check": false },
        { "tex": "\\Rightarrow y - 6\\ln 5 = \\frac{3}{25}(x - 0)", "marks": ["dM1"] },
        { "tex": "\\Rightarrow 25(y - 6\\ln 5) = 3x", "why": "Multiply both sides by 25." },
        { "tex": "\\Rightarrow 25y - 150\\ln 5 = 3x" }
      ],
      "answer": "\\Rightarrow -3x + 25y = 150\\ln 5",
      "answerMarks": ["A1"],
      "check": {
        "vals": { "x": 25, "y": "6*log(5) + 3" },
        "marks": ["B1ft", "M1", "dM1", "A1"],
        "answers": [{ "tex": "-3x + 25y = 150\\ln 5", "kind": "equation", "scheme": "Eq(25*y - 3*x, 150*log(5))", "derive": "Eq(y - 3*log(25), diff(3*log(x + 25), x).subs(x, 0)*x)" }]
      }
    }
  ]
}
