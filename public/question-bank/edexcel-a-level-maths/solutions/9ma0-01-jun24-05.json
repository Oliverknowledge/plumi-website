{
  "id": "9ma0-01-jun24-05",
  "q": "5",
  "m": 6,
  "parts": [
    {
      "label": "a",
      "ask": "\\(\\mathrm{f}(x) = \\dfrac{2x-3}{x^2+4}\\). Show that \\(\\mathrm{f}'(x) = \\dfrac{ax^2+bx+c}{(x^2+4)^2}\\), finding \\(a\\), \\(b\\) and \\(c\\).",
      "method": "Quotient rule",
      "steps": [
        { "tex": "\\mathrm{f}'(x) = \\frac{(x^2+4)(2) - (2x-3)(2x)}{(x^2+4)^2}", "why": "Formula book: \\(\\dfrac{vu' - uv'}{v^2}\\), with \\(u = 2x - 3\\), \\(v = x^2 + 4\\).", "marks": ["M1", "A1"] },
        { "tex": "= \\frac{2x^2 + 8 - (4x^2 - 6x)}{(x^2+4)^2}", "why": "Keep the bracket: the minus turns \\(-6x\\) into \\(+6x\\)." }
      ],
      "answer": "\\mathrm{f}'(x) = \\frac{-2x^2 + 6x + 8}{(x^2+4)^2}, \\quad a = -2,\\ b = 6,\\ c = 8",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["M1", "A1", "A1"],
        "answers": [{ "tex": "\\frac{-2x^2 + 6x + 8}{(x^2+4)^2}", "scheme": "(-2*x**2 + 6*x + 8)/(x**2 + 4)**2", "derive": "diff((2*x - 3)/(x**2 + 4), x)" }]
      }
    },
    {
      "label": "b",
      "ask": "Hence, using algebra, find the values of \\(x\\) for which f is decreasing.",
      "method": "Solve \\(\\mathrm{f}'(x) < 0\\)",
      "steps": [
        { "text": "f is decreasing where \\(\\mathrm{f}'(x) < 0\\). The denominator \\((x^2+4)^2\\) is always positive, so:" },
        { "tex": "-2x^2 + 6x + 8 = -2(x+1)(x-4) < 0", "why": "\"Using algebra\": show the factorising, not just calculator roots." },
        { "text": "Critical values \\(x = -1\\) and \\(x = 4\\).", "marks": ["B1"] },
        { "text": "The parabola is upside down, so it is negative outside its roots.", "why": "Or divide by \\(-2\\) and flip: \\((x+1)(x-4) > 0\\).", "marks": ["M1"] }
      ],
      "answer": "x < -1 \\ \\text{or}\\ x > 4",
      "answerMarks": ["A1"],
      "check": {
        "marks": ["B1", "M1", "A1"],
        "answers": [{ "tex": "x < -1 \\ \\text{or}\\ x > 4", "kind": "set", "scheme": "Union(Interval.open(-oo, -1), Interval.open(4, oo))", "derive": "solveset(diff((2*x - 3)/(x**2 + 4), x) < 0, x, S.Reals)" }]
      }
    }
  ]
}
