{
  "id": "9ma0-02-jun23-04",
  "q": "4",
  "m": 4,
  "parts": [
    {
      "label": "a",
      "ask": "The temperature of coffee, \\(H\\) °C, \\(t\\) minutes after it is poured, is modelled by \\(H = A\\mathrm{e}^{-Bt} + 30\\). Initially it was 85 °C. State the value of \\(A\\).",
      "method": "\"Initially\" means \\(t = 0\\)",
      "steps": [
        { "tex": "85 = A\\mathrm{e}^{0} + 30", "why": "\\(\\mathrm{e}^0 = 1\\)." }
      ],
      "answer": "\\Rightarrow A = 85 - 30 = 55",
      "answerMarks": ["B1"],
      "check": {
        "vals": { "A": 55 },
        "marks": ["B1"],
        "answers": [{ "tex": "55", "scheme": "55", "derive": "85 - 30" }]
      }
    },
    {
      "label": "b",
      "ask": "Initially the coffee was cooling at a rate of 7.5 °C per minute. Find a complete equation linking \\(H\\) and \\(t\\), giving \\(B\\) to 3 decimal places.",
      "method": "Differentiate, then use the rate at \\(t = 0\\)",
      "steps": [
        { "tex": "H = 55\\mathrm{e}^{-Bt} + 30", "check": false },
        { "tex": "\\Rightarrow \\frac{\\mathrm{d}H}{\\mathrm{d}t} = -55B\\mathrm{e}^{-Bt}", "why": "\\(\\mathrm{e}^{kt} \\to k\\mathrm{e}^{kt}\\), with \\(k = -B\\).", "marks": ["M1"], "check": false },
        { "tex": "\\Rightarrow -55B\\mathrm{e}^{0} = -7.5", "why": "Cooling means \\(H\\) is falling: the rate is \\(-7.5\\), not \\(+7.5\\)." },
        { "tex": "\\Rightarrow B = \\frac{7.5}{55} = \\frac{3}{22} = 0.13636\\ldots", "marks": ["M1"] }
      ],
      "answer": "\\Rightarrow H = 55\\mathrm{e}^{-0.136t} + 30",
      "answerMarks": ["A1cso"],
      "check": {
        "vals": { "B": "3/22" },
        "marks": ["M1", "M1", "A1cso"],
        "answers": [{ "tex": "55\\mathrm{e}^{-0.136t} + 30", "scheme": "55*exp(-0.136*t) + 30", "derive": "55*exp(-Rational(15, 2)/55*t) + 30", "tol": 0.05 }]
      }
    }
  ]
}
